{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dream Windows",
  "version": "0.1.0",
  "identifier": "com.dream.local.windows",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dream Windows",
        "width": 1536,
        "height": 1024,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
