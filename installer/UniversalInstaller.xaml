<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-LLM Universal Installer" Height="720" Width="1040"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="M-LLM Universal Installer" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/>
        <TextBlock Text="Windows 10/11 · Admin-first · Resumable · Multi-source · Rollback-safe" Margin="0,5,0,0" Foreground="#526174"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#E8EEF8" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
        <TextBlock x:Name="AdminStatusText" Text="Administrator: checking" FontWeight="SemiBold" Foreground="#244A73"/>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine" FontWeight="SemiBold" Margin="0,3,10,7"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MachineStatusText" Text="Detecting..." Margin="0,3,0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Install root" FontWeight="SemiBold" Margin="0,3,10,7"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InstallRootText" Text="-" Margin="0,3,0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stage" FontWeight="SemiBold" Margin="0,3,10,7"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StageText" Text="INIT" Margin="0,3,0,7"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Source" FontWeight="SemiBold" Margin="0,3,10,7"/>
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SourceText" Text="Not selected" Margin="0,3,0,7"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" FontWeight="SemiBold" Margin="0,3,10,0"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatusText" Text="Ready" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <StackPanel>
        <ProgressBar x:Name="ProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"/>
        <WrapPanel Margin="0,14,0,0">
          <Button x:Name="InstallResumeButton" Content="Install / Resume" MinWidth="135" Height="36" Margin="0,0,8,8" Padding="14,0"/>
          <Button x:Name="RetryAcquisitionButton" Content="Retry Acquisition" MinWidth="135" Height="36" Margin="0,0,8,8" Padding="14,0"/>
          <Button x:Name="ImportOfflineButton" Content="Import Offline Package" MinWidth="165" Height="36" Margin="0,0,8,8" Padding="14,0"/>
          <Button x:Name="EvidenceButton" Content="Open Evidence Folder" MinWidth="155" Height="36" Margin="0,0,8,8" Padding="14,0"/>
          <Button x:Name="RollbackButton" Content="Rollback" MinWidth="110" Height="36" Margin="0,0,0,8" Padding="14,0"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="#101827" CornerRadius="8" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Installer log / source attempts" Foreground="#C7D2E3" FontWeight="SemiBold" Margin="2,0,0,8"/>
        <TextBox Grid.Row="1" x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#101827" Foreground="#E8EEF8" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" Margin="2,12,0,0" Foreground="#66768A"
               Text="Phase 1 foundation: no driver, DISM, boot or firmware modification."/>
  </Grid>
</Window>
