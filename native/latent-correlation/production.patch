+
+namespace fs = std::filesystem;
+struct SDCliParams {
+    std::string latent_trace_path;
+    int last_latent_trace_step = -1;
+    std::vector<float> previous_latent;
+    int compression_quality = 0;
+};
+#define LOG_WARN(...) std::fprintf(stderr, __VA_ARGS__)
+#define LOG_ERROR(...) std::fprintf(stderr, __VA_ARGS__)
+static bool write_image_to_file(const std::string& path, uint8_t* pixels, uint32_t width,
+                                uint32_t height, int channels, const std::string&, int) {
+    return stbi_write_png(path.c_str(), width, height, channels, pixels, width * channels) != 0;
+}
+#include "latent_trace_writer.h"
+
+static void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+static nlohmann::json capture(const fs::path& root, const char* name, const std::vector<float>& values,
+                              int64_t plane, int64_t channels, int64_t batch) {
+    fs::path directory = root / name;
+    fs::create_directories(directory);
+    fs::path path = directory / "latent-metrics.jsonl";
+    require(!fs::exists(path), "use a fresh output directory");
+    SDCliParams params;
+    params.latent_trace_path = path.string();
+    const int64_t shape[] = {plane, 1, channels, batch};
+    latent_trace_callback(0, values.data(), values.size(), 4, shape, &params);
+    std::ifstream input(path);
+    nlohmann::json raw;
+    input >> raw;
+    require(raw.contains("channel_correlation"), "writer must export channel_correlation from floats");
+    return raw["channel_correlation"];
+}
+int main(int argc, char** argv) {
+    try {
+        require(argc == 2, "pass a fresh artifact directory");
+        const fs::path root(argv[1]);
+        // C0=[1,2,3,4], C1=2*C0, C2=-C0, C3=constant, split across two batches.
+        auto matrix = capture(root, "signed-constant", {1,2, 2,4, -1,-2, 7,7, 3,4, 6,8, -3,-4, 7,7}, 2, 4, 2);
+        require(matrix == nlohmann::json::parse("[[1,1,-1,null],[1,1,-1,null],[-1,-1,1,null],[null,null,null,null]]"), "positive/negative/constant Pearson mismatch");
+        // With one pixel per batch each PNG is constant; across batches r=-1.
+        matrix = capture(root, "batch-only", {1,2, 2,1}, 1, 2, 2);
+        require(matrix == nlohmann::json::parse("[[1,-1],[-1,1]]"), "must reduce across every batch");
+        // Centered vectors have dot=1 and squared norms=2, hence r=1/2.
+        matrix = capture(root, "half", {-1,0,1, -1,1,0}, 3, 2, 1);
+        require(std::abs(matrix[0][1].get<double>() - .5) < 1e-7, "hand-derived r=1/2 mismatch");
+        matrix = capture(root, "zero", {-1,0,1, 1,-2,1}, 3, 2, 1);
+        require(matrix[0][1] == 0, "orthogonal centered channels must have zero correlation");
+        matrix = capture(root, "large-offset", {100000000,100000008,100000016, -1,0,1}, 3, 2, 1);
+        require(matrix[0][1] == 1, "centered covariance must resist cancellation");
+        matrix = capture(root, "nonfinite", {1,2,3, 1,std::numeric_limits<float>::infinity(),3, 1,2,std::numeric_limits<float>::quiet_NaN()}, 3, 3, 1);
+        require(matrix == nlohmann::json::parse("[[1,null,null],[null,null,null],[null,null,null]]"), "nonfinite channels must be undefined, including diagonal");
+        matrix = capture(root, "singleton", {2,3}, 1, 2, 1);
+        require(matrix == nlohmann::json::parse("[[null,null],[null,null]]"), "one observation has zero variance");
+        std::cout << "PASS: 7 original-float writer cases (CPU only)\n";
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
