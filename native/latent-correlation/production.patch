+static void latent_trace_callback(int step,
+                                  const float* values,
+                                  int64_t value_count,
+                                  int n_dims,
+                                  const int64_t* shape,
+                                  void* data) {
+    auto* cli_params = static_cast<SDCliParams*>(data);
+    if (cli_params == nullptr || cli_params->latent_trace_path.empty() || values == nullptr || shape == nullptr || value_count <= 0 || n_dims < 2 || n_dims > 4) {
+        return;
+    }
+    // Some higher-order samplers evaluate a logical step more than once. Keep
+    // one sample per displayed step so the UI scrubber matches user intent.
+    if (step <= cli_params->last_latent_trace_step) {
+        return;
+    }
+
+    int64_t width = shape[0];
+    int64_t height = shape[1];
+    int64_t channels = n_dims >= 3 ? shape[2] : 1;
+    int64_t batch = n_dims >= 4 ? shape[3] : 1;
+    if (width <= 0 || height <= 0 || channels <= 0 || batch <= 0 || channels > 16 || width * height * channels * batch != value_count) {
+        LOG_WARN("ignoring invalid latent trace shape at step %d", step);
+        return;
+    }
+    const int64_t plane = width * height;
+    const int channel_count = static_cast<int>(channels);
+    const size_t count = static_cast<size_t>(value_count);
+    const auto correlation = sd_latent::channel_correlation(values, static_cast<size_t>(plane),
+                                                           static_cast<size_t>(channels), static_cast<size_t>(batch));
+    double sum = 0.0;
+    double sum_sq = 0.0;
+    float aggregate_min = std::numeric_limits<float>::infinity();
+    float aggregate_max = -std::numeric_limits<float>::infinity();
+    for (size_t index = 0; index < count; ++index) {
+        const float value = values[index];
+        if (!std::isfinite(value)) {
+            continue;
+        }
+        sum += value;
+        sum_sq += static_cast<double>(value) * value;
+        aggregate_min = std::min(aggregate_min, value);
+        aggregate_max = std::max(aggregate_max, value);
+    }
+    const double mean = sum / static_cast<double>(count);
+    const double variance = std::max(0.0, sum_sq / static_cast<double>(count) - mean * mean);
+    const double l2 = std::sqrt(sum_sq);
+
+    double delta_l2 = std::numeric_limits<double>::quiet_NaN();
+    double delta_mean_abs = std::numeric_limits<double>::quiet_NaN();
+    double cosine = std::numeric_limits<double>::quiet_NaN();
+    std::vector<double> spatial_delta;
+    if (cli_params->previous_latent.size() == count) {
+        spatial_delta.assign(static_cast<size_t>(plane), 0.0);
+        bool finite_delta = true;
+        double delta_sq = 0.0;
+        double delta_abs = 0.0;
+        double dot = 0.0;
+        double previous_sq = 0.0;
+        for (size_t index = 0; index < count; ++index) {
+            const double current = values[index];
+            const double previous = cli_params->previous_latent[index];
+            const double delta = current - previous;
+            finite_delta = finite_delta && std::isfinite(delta);
+            spatial_delta[index % static_cast<size_t>(plane)] += std::abs(delta);
+            delta_sq += delta * delta;
+            delta_abs += std::abs(delta);
+            dot += current * previous;
+            previous_sq += previous * previous;
+        }
+        delta_l2 = std::sqrt(delta_sq);
+        delta_mean_abs = delta_abs / static_cast<double>(count);
+        const double denominator = std::sqrt(sum_sq * previous_sq);
+        cosine = denominator > 0.0 ? dot / denominator : 0.0;
