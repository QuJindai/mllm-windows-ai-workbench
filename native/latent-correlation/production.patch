+    fs::path metrics_path(cli_params->latent_trace_path);
+    std::error_code error;
+    fs::create_directories(metrics_path.parent_path(), error);
+    std::ofstream metrics(metrics_path, std::ios::app);
+    if (!metrics) {
+        LOG_ERROR("open latent trace '%s' failed", metrics_path.string().c_str());
+        return;
+    }
+    std::string delta_file_name;
+    if (!spatial_delta.empty()) {
+        const double maximum = *std::max_element(spatial_delta.begin(), spatial_delta.end());
+        std::vector<uint8_t> image(spatial_delta.size());
+        for (size_t pixel = 0; pixel < image.size(); ++pixel) {
+            image[pixel] = maximum > 0.0 ? static_cast<uint8_t>(std::clamp(spatial_delta[pixel] / maximum * 255.0, 0.0, 255.0)) : 0;
+        }
+        char name[64];
+        std::snprintf(name, sizeof(name), "latent-step-%03d-delta.png", step);
+        if (write_image_to_file((metrics_path.parent_path() / name).string(), image.data(),
+                                static_cast<uint32_t>(width), static_cast<uint32_t>(height), 1, "", cli_params->compression_quality)) {
+            delta_file_name = name;
+        } else {
+            LOG_WARN("save latent delta map '%s' failed", name);
+        }
+    }
+    metrics << "{\"step\":" << step;
+    if (!delta_file_name.empty()) metrics << ",\"delta_file_name\":\"" << delta_file_name << '\"';
+    metrics << ",\"shape\":[";
+    for (int dimension = 0; dimension < n_dims; ++dimension) {
+        if (dimension > 0) metrics << ',';
+        metrics << shape[dimension];
+    }
+    metrics << "],\"mean\":";
+    write_json_number(metrics, static_cast<float>(mean));
+    metrics << ",\"std\":";
+    write_json_number(metrics, static_cast<float>(std::sqrt(variance)));
+    metrics << ",\"l2\":";
+    write_json_number(metrics, static_cast<float>(l2));
+    metrics << ",\"delta_l2\":";
+    write_json_number(metrics, static_cast<float>(delta_l2));
+    metrics << ",\"delta_mean_abs\":";
+    write_json_number(metrics, static_cast<float>(delta_mean_abs));
+    metrics << ",\"cosine\":";
+    write_json_number(metrics, static_cast<float>(cosine));
+    metrics << ",\"channel_correlation\":[";
+    for (size_t row = 0; row < correlation.size(); ++row) {
+        if (row > 0) metrics << ',';
+        metrics << '[';
+        for (size_t column = 0; column < correlation[row].size(); ++column) {
+            if (column > 0) metrics << ',';
+            write_json_number(metrics, static_cast<float>(correlation[row][column]));
+        }
+        metrics << ']';
+    }
+    metrics << "],\"truth\":\"observed\",\"kind\":\"latent-state\",\"channels\":[";
+
+    for (int channel = 0; channel < channel_count; ++channel) {
+        if (channel > 0) metrics << ',';
+        float channel_min = std::numeric_limits<float>::infinity();
+        float channel_max = -std::numeric_limits<float>::infinity();
+        double channel_sum = 0.0;
+        double channel_sq = 0.0;
+        std::vector<int> histogram(32, 0);
+        for (int64_t batch_index = 0; batch_index < batch; ++batch_index) {
+            const size_t offset = static_cast<size_t>((batch_index * channel_count + channel) * plane);
+            for (int64_t pixel = 0; pixel < plane; ++pixel) {
+                const float value = values[offset + static_cast<size_t>(pixel)];
