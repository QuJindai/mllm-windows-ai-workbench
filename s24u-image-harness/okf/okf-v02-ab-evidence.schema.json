{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qujindai.local/schemas/okf-v02-ab-evidence.schema.json",
  "title": "OKF v0.2 Android A/B/C Evidence Record",
  "type": "object",
  "required": ["run_id", "arm", "model_id", "question_id", "answer", "metrics", "retrieval"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "arm": { "enum": ["BARE", "MARKDOWN", "OKF_V02"] },
    "model_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "answer": { "type": "string" },
    "metrics": {
      "type": "object",
      "required": ["total_latency_ms", "generated_tokens"],
      "properties": {
        "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
        "decode_tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
        "total_latency_ms": { "type": "number", "minimum": 0 },
        "input_token_estimate": { "type": ["integer", "null"], "minimum": 0 },
        "generated_tokens": { "type": "integer", "minimum": 0 },
        "retrieval_latency_ms": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "retrieval": {
      "type": "object",
      "required": ["selected_ids"],
      "properties": {
        "selected_ids": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "trust_tiers": {
          "type": "array",
          "items": { "enum": ["unverified", "machine-confirmed", "human-reviewed"] }
        },
        "stale_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "score": { "type": ["object", "null"], "additionalProperties": true }
  },
  "additionalProperties": true
}
