<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Dashboard.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
    <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,20" Foreground="{StaticResource MutedTextBrush}" />
    <UniformGrid Columns="2" Rows="2">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12"><StackPanel><TextBlock Text="系统概览" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="正在读取 Safe Core 结构化状态…" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="组件健康" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="正在读取组件状态…" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="服务状态" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="等待真实服务检测结果…" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="当前模型" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="等待真实模型检测结果…" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
    </UniformGrid>
  </StackPanel>
</UserControl>
