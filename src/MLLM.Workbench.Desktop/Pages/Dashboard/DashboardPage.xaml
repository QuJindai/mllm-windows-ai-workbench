<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Dashboard.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><Button Grid.Column="1" Content="刷新" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid>

    <Border Margin="0,0,0,14" Background="#4A1D2A" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding BackendError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><TextBlock Text="Safe Core 后端错误" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/><TextBlock Text="{Binding BackendError}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="White"/></StackPanel>
    </Border>

    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="系统概览" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding OperatingSystem}" Margin="0,14,0,0" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="{Binding Cpu}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Ram, StringFormat=内存：{0}}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Gpu}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding DiskFree, StringFormat=磁盘可用：{0}}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="组件健康" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding PassCount, StringFormat=正常：{0}}" Margin="0,14,0,0" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding RunningCount, StringFormat=运行中：{0}}" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding ReadyCount, StringFormat=可安装：{0}}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding BlockedCount, StringFormat=受阻：{0}}" Margin="0,7,0,0" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="本地服务" FontWeight="SemiBold" Foreground="White"/><ItemsControl ItemsSource="{Binding ServiceComponents}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Id}" Foreground="White"/><TextBlock Text="{Binding Health}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="未检测到服务组件" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ServiceComponents.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="当前模型" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding CurrentModelDisplay}" Margin="0,14,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="模型信息仅来自 Safe Core 检测，不使用演示数据。" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
    </Grid>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="快速操作" FontSize="16" FontWeight="SemiBold" Foreground="White"/><WrapPanel Margin="0,14,0,0"><Button Content="运行 Doctor" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenDoctorCommand}"/><Button Content="安装 / 恢复组件" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenInstallationCommand}"/><Button x:Name="OpenModelsButton" AutomationProperties.AutomationId="OpenModelsButton" Content="管理模型" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenModelsCommand}"/><Button x:Name="OpenServicesButton" AutomationProperties.AutomationId="OpenServicesButton" Content="本地服务" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenServicesCommand}"/></WrapPanel></StackPanel></Border>

    <Border Style="{StaticResource SafeGateCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="安全细节 (Safe Gate)" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Desktop 默认普通用户运行；安装和修复的提权由 Universal Installer 单独处理。" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Margin="12,0,0,0"><TextBlock Text="{Binding NetworkMode}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/></Border></Grid></Border>
  </StackPanel>
</UserControl>
