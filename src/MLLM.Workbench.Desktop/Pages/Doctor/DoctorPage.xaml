<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Doctor.DoctorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
        <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="重新检测" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
    </Grid>

    <Border Margin="0,0,0,14" Background="#4A1D2A" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProductFault}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel>
        <TextBlock Text="产品故障 / 检测链异常" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
        <TextBlock Text="{Binding ProductFaultMessage}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="White"/>
        <TextBlock Text="组件未安装、可安装或依赖受阻不会进入此区域。" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <Grid Margin="0,0,0,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
          <TextBlock Text="组件" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Grid.Column="1" Text="状态" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Grid.Column="2" Text="详情" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Grid.Column="3" Text="建议" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Id}" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayState}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding Recommendation}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="等待 Doctor 结构化结果…" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
