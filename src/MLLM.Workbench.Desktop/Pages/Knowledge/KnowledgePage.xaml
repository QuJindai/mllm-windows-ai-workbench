<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Knowledge.KnowledgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
  <StackPanel>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="知识工作台" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="本地 FTS5 · Embedding · Hybrid · RAG 证据链" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center" />
    </Grid>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="FTS5" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock AutomationProperties.AutomationId="KnowledgeFtsStatus" Text="{Binding Fts5Status}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Embedding" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock AutomationProperties.AutomationId="KnowledgeEmbeddingStatus" Text="{Binding EmbeddingStatus}" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Hybrid" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock AutomationProperties.AutomationId="KnowledgeHybridStatus" Text="{Binding HybridStatus}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="知识库" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding DatabasePath, StringFormat=SQLite: {0}}" Margin="0,6,0,14" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" AutomationProperties.AutomationId="KnowledgeImportPath" Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeBrowseButton" Content="选择文件" Click="BrowseKnowledgeFile_Click" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
          <Button Grid.Column="2" AutomationProperties.AutomationId="KnowledgeImportButton" Content="导入并建索引" Command="{Binding ImportCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
        </Grid>
        <TextBlock Text="当前真实支持 Markdown / Text（.md、.markdown、.txt）。PDF 尚未接入解析器，不会伪装导入。" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="检索" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" AutomationProperties.AutomationId="KnowledgeQueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center" />
          <ComboBox Grid.Column="1" AutomationProperties.AutomationId="KnowledgeSearchMode" ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SelectedSearchMode}" Margin="10,0,0,0" MinHeight="38" Padding="8" />
          <Button Grid.Column="2" AutomationProperties.AutomationId="KnowledgeSearchButton" Content="开始检索" Command="{Binding SearchCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeOpenEvidence" Content="打开所选原文" Command="{Binding OpenSelectedEvidenceCommand}" Style="{StaticResource ActionButtonStyle}" />
        </Grid>
        <DataGrid AutomationProperties.AutomationId="KnowledgeResults" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,10,0,0" MinHeight="230" Background="{StaticResource CardSecondaryBrush}" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="150" />
            <DataGridTextColumn Header="来源" Binding="{Binding SourceUri}" Width="220" />
            <DataGridTextColumn Header="Chunk" Binding="{Binding ChunkId}" Width="170" />
            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="60" />
            <DataGridTextColumn Header="分数" Binding="{Binding Score, StringFormat=0.0000}" Width="80" />
            <DataGridTextColumn Header="证据" Binding="{Binding Excerpt}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="RAG 证据上下文" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="每条上下文带稳定 [K1]… 引用，并保留 source/chunk，可直接用于本地模型回答。" Margin="0,6,0,10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <TextBox AutomationProperties.AutomationId="KnowledgeRagContext" Text="{Binding RagContextText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180" Padding="12" Background="{StaticResource CardSecondaryBrush}" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" />
      </StackPanel>
    </Border>

    <Border Background="#2B1520" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
      <TextBlock Text="{Binding LastError, TargetNullValue=就绪}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
