<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Knowledge.KnowledgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <StackPanel>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="知识工作台" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="本地 FTS5 · Embedding · Hybrid · RAG 证据链" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeRefreshButton" Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}" />
    </Grid>

    <UniformGrid Columns="4" Margin="0,0,0,16">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="FTS5" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Fts5Status}" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="8,0">
        <StackPanel><TextBlock Text="Embedding" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding EmbeddingStatus}" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="8,0">
        <StackPanel><TextBlock Text="Vector Index" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding EmbeddingIndexStatus}" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
        <StackPanel><TextBlock Text="Hybrid" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding HybridStatus}" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/></StackPanel>
      </Border>
    </UniformGrid>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="知识库" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding DatabasePath, StringFormat=SQLite: {0}}" Margin="0,6,0,14" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" AutomationProperties.AutomationId="KnowledgeImportPath" Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeBrowseButton" Content="选择文件" Click="BrowseKnowledgeFile_Click" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
          <Button Grid.Column="2" AutomationProperties.AutomationId="KnowledgeImportButton" Content="导入并建索引" Command="{Binding ImportCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
        </Grid>
        <TextBlock Text="当前真实支持 Markdown / Text、文本型 PDF（保留页码定位）和 DOCX（保留段落定位）。扫描或纯图片 PDF 需要 OCR，当前不会伪装识别。" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="向量索引" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding EmbeddingProgressText}" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeBuildEmbeddingIndex" Content="补建 / 继续向量索引" Command="{Binding BuildEmbeddingIndexCommand}" Style="{StaticResource ActionButtonStyle}" />
        </Grid>
        <ProgressBar AutomationProperties.AutomationId="KnowledgeEmbeddingProgress" Minimum="0" Maximum="100" Value="{Binding EmbeddingProgressPercent, Mode=OneWay}" Height="14" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="检索" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" AutomationProperties.AutomationId="KnowledgeQueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center" />
          <ComboBox Grid.Column="1" AutomationProperties.AutomationId="KnowledgeSearchMode" ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SelectedSearchMode}" Margin="10,0,0,0" MinHeight="38" Padding="8" />
          <Button Grid.Column="2" AutomationProperties.AutomationId="KnowledgeSearchButton" Content="开始检索" Command="{Binding SearchCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" AutomationProperties.AutomationId="KnowledgeOpenEvidence" Content="打开所选原文" Command="{Binding OpenSelectedEvidenceCommand}" Style="{StaticResource ActionButtonStyle}" />
        </Grid>
        <DataGrid AutomationProperties.AutomationId="KnowledgeResults" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,10,0,0" MinHeight="230" Background="{StaticResource CardSecondaryBrush}" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="140" />
            <DataGridTextColumn Header="来源" Binding="{Binding SourceUri}" Width="210" />
            <DataGridTextColumn Header="定位" Binding="{Binding Locator}" Width="100" />
            <DataGridTextColumn Header="Chunk" Binding="{Binding ChunkId}" Width="160" />
            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="60" />
            <DataGridTextColumn Header="分数" Binding="{Binding Score, StringFormat=0.0000}" Width="80" />
            <DataGridTextColumn Header="证据" Binding="{Binding Excerpt}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="证据显微镜" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="选中一条检索结果后，拆解 FTS 排名与词法分数、Embedding cosine 相似度，以及 Hybrid 的 RRF 双路贡献。" Margin="0,6,0,10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <TextBox AutomationProperties.AutomationId="KnowledgeEvidenceMicroscope"
                 Text="{Binding EvidenceMicroscopeText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="150"
                 Padding="12"
                 Background="{StaticResource CardSecondaryBrush}"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="RAG 证据上下文" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="每条上下文带稳定 [K1]… 引用，并保留 source/chunk/locator，可直接用于本地模型回答并回查页码或段落。" Margin="0,6,0,10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <TextBox AutomationProperties.AutomationId="KnowledgeRagContext" Text="{Binding RagContextText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180" Padding="12" Background="{StaticResource CardSecondaryBrush}" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" />
      </StackPanel>
    </Border>

    <Border Background="#2B1520" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
      <TextBlock Text="{Binding LastError, TargetNullValue=就绪}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
