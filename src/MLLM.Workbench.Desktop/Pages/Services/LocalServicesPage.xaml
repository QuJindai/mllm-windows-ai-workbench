<UserControl x:Class="MLLM.Workbench.Desktop.Pages.Services.LocalServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="LocalServicesPageRoot"
             AutomationProperties.AutomationId="LocalServicesPageRoot">
  <StackPanel>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
        <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
      </StackPanel>
      <Button Grid.Column="1" x:Name="RefreshServicesButton" AutomationProperties.AutomationId="RefreshServicesButton"
              Content="刷新服务" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}"/>
    </Grid>
    <Border Style="{StaticResource CardStyle}">
      <TextBlock Text="本地服务控制将复用现有 Phase B 受限服务后端。" Foreground="White" TextWrapping="Wrap"/>
    </Border>
  </StackPanel>
</UserControl>
