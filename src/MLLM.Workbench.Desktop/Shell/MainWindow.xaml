<Window x:Class="MLLM.Workbench.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dashboard="clr-namespace:MLLM.Workbench.Desktop.Pages.Dashboard"
        xmlns:doctor="clr-namespace:MLLM.Workbench.Desktop.Pages.Doctor"
        xmlns:installation="clr-namespace:MLLM.Workbench.Desktop.Pages.Installation"
        xmlns:models="clr-namespace:MLLM.Workbench.Desktop.Pages.Models"
        xmlns:services="clr-namespace:MLLM.Workbench.Desktop.Pages.Services"
        xmlns:knowledge="clr-namespace:MLLM.Workbench.Desktop.Pages.Knowledge"
        xmlns:conversation="clr-namespace:MLLM.Workbench.Desktop.Pages.Conversation"
        mc:Ignorable="d"
        Title="M-LLM Windows AI Workbench"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackgroundBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type dashboard:DashboardPageViewModel}"><dashboard:DashboardPage /></DataTemplate>
    <DataTemplate DataType="{x:Type doctor:DoctorPageViewModel}"><doctor:DoctorPage /></DataTemplate>
    <DataTemplate DataType="{x:Type installation:InstallationPageViewModel}"><installation:InstallationPage /></DataTemplate>
    <DataTemplate DataType="{x:Type models:ModelManagementPageViewModel}"><models:ModelManagementPage /></DataTemplate>
    <DataTemplate DataType="{x:Type services:LocalServicesPageViewModel}"><services:LocalServicesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type knowledge:KnowledgePageViewModel}"><knowledge:KnowledgePage /></DataTemplate>
    <DataTemplate DataType="{x:Type conversation:ConversationPageViewModel}"><conversation:ConversationPage /></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="8,12,8,28">
          <TextBlock Text="M-LLM" FontSize="26" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Windows AI Workbench" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="Knowledge Phase C" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="MainNavigation" AutomationProperties.AutomationId="MainNavigation">
          <Button x:Name="DashboardNavigation" AutomationProperties.AutomationId="DashboardNavigation" Style="{StaticResource NavigationButtonStyle}" Content="工作台" Command="{Binding NavigateDashboardCommand}" />
          <Button x:Name="DoctorNavigation" AutomationProperties.AutomationId="DoctorNavigation" Style="{StaticResource NavigationButtonStyle}" Content="系统体检 (Doctor)" Command="{Binding NavigateDoctorCommand}" />
          <Button x:Name="InstallationNavigation" AutomationProperties.AutomationId="InstallationNavigation" Style="{StaticResource NavigationButtonStyle}" Content="安装中心" Command="{Binding NavigateInstallationCommand}" />
          <Button x:Name="ModelNavigation" AutomationProperties.AutomationId="ModelNavigation" Style="{StaticResource NavigationButtonStyle}" Content="模型管理" Command="{Binding NavigateModelsCommand}" />
          <Button x:Name="ServicesNavigation" AutomationProperties.AutomationId="ServicesNavigation" Style="{StaticResource NavigationButtonStyle}" Content="本地服务" Command="{Binding NavigateServicesCommand}" />
          <Button x:Name="KnowledgeNavigation" AutomationProperties.AutomationId="KnowledgeNavigation" Style="{StaticResource NavigationButtonStyle}" Content="知识工作台" Command="{Binding NavigateKnowledgeCommand}" />
          <Button x:Name="ConversationNavigation" AutomationProperties.AutomationId="ConversationNavigation" Style="{StaticResource NavigationButtonStyle}" Content="对话测试" Command="{Binding NavigateConversationCommand}" />
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource SafeGateCardStyle}">
          <StackPanel>
            <TextBlock Text="安全模式" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
            <TextBlock Text="Safe Core · Local only" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="M-LLM Windows AI Workbench" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Margin="0,0,12,0">
            <TextBlock x:Name="BackendStatus" AutomationProperties.AutomationId="BackendStatus" Text="{Binding BackendStatus}" Foreground="{StaticResource MutedTextBrush}" />
          </Border>
          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}">
            <TextBlock x:Name="NetworkModeStatus" AutomationProperties.AutomationId="NetworkModeStatus" Text="{Binding NetworkMode}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <ContentControl x:Name="ContentHost" AutomationProperties.AutomationId="ContentHost" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <TextBlock Margin="24,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Desktop runs as standard user · Safe Core + local knowledge stay non-privileged" />
      </Border>
    </Grid>
  </Grid>
</Window>
